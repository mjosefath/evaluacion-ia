{
  "ConnectionStrings": {
    "Identity": "",
    "System": ""
  },
  "Jwt": {
    "Issuer": "Inventario.Api",
    "Audience": "Inventario.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
