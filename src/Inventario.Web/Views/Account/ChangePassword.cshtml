@model Inventario.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1 class="app-page-title">Cambiar contraseña</h1>

<form asp-controller="Account" asp-action="ChangePassword" method="post" class="card" style="max-width: 420px;" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

    <div class="form-field">
        <label class="form-label" asp-for="CurrentPassword">Contraseña actual</label>
        <input class="form-input" asp-for="CurrentPassword" autocomplete="current-password" />
        <span class="form-error" asp-validation-for="CurrentPassword"></span>
    </div>

    <div class="form-field">
        <label class="form-label" asp-for="NewPassword">Contraseña nueva</label>
        <input class="form-input" asp-for="NewPassword" autocomplete="new-password" />
        <span class="form-error" asp-validation-for="NewPassword"></span>
    </div>

    <div class="form-field">
        <label class="form-label" asp-for="ConfirmPassword">Confirmar contraseña</label>
        <input class="form-input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="form-error" asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
