@model Inventario.Web.Models.ProductIndexViewModel
@using Inventario.Contracts.Security
@using Inventario.Web.Security
@{
    ViewData["Title"] = "Productos";
    var q = Model.Query;
    var result = Model.Result;
    var canCreate = PermissionClaims.Has(User, PermissionCodes.ProductosCrear);
    var canEdit = PermissionClaims.Has(User, PermissionCodes.ProductosEditar);
    var canActivate = PermissionClaims.Has(User, PermissionCodes.ProductosActivar);
    var showActions = canEdit || canActivate;
    var filters = await Html.PartialAsync("_ProductFilters", Model);
    var filterBar = new FilterBarModel
    {
        Search = q.Search,
        SearchPlaceholder = "Buscar productos…",
        Filters = filters
    };
    var paginator = new PaginatorModel
    {
        Page = result.Page,
        PageSize = result.PageSize,
        TotalRows = result.TotalRows
    };

    string SortUrl(string column)
    {
        var nextDir = string.Equals(q.Sort, column, StringComparison.OrdinalIgnoreCase)
                      && !string.Equals(q.Dir, "desc", StringComparison.OrdinalIgnoreCase)
            ? "desc"
            : "asc";

        var values = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = q.PageSize.ToString(),
            ["sort"] = column,
            ["dir"] = nextDir
        };
        if (!string.IsNullOrWhiteSpace(q.Search))
        {
            values["search"] = q.Search;
        }

        if (q.CategoryId.HasValue)
        {
            values["categoryId"] = q.CategoryId.Value.ToString();
        }

        if (Model.StatusFilterAll)
        {
            values["statusId"] = "";
        }
        else if (q.StatusId.HasValue)
        {
            values["statusId"] = q.StatusId.Value.ToString();
        }

        return Url.Action("Index", "Products", values)!;
    }

    string Ind(string column) =>
        !string.Equals(q.Sort, column, StringComparison.OrdinalIgnoreCase)
            ? ""
            : string.Equals(q.Dir, "desc", StringComparison.OrdinalIgnoreCase) ? " ↓" : " ↑";
}

<div class="page-toolbar">
    <h1 class="app-page-title page-toolbar__title">Productos</h1>
    @if (canCreate)
    {
        <button type="button"
                class="btn btn-primary"
                data-modal-open="app-action-modal"
                data-modal-title="Nuevo producto"
                data-modal-url="@Url.Action("CreateForm", "Products")">
            Nuevo producto
        </button>
    }
</div>

<div data-list-page data-list-navigate="reload">
    <partial name="Ui/_FilterBar" model="filterBar" />

    <div class="table-panel" data-list-table>
        @if (result.TotalRows == 0)
        {
            <div class="empty-state">
                @if (!string.IsNullOrWhiteSpace(q.Search))
                {
                    <p>No hay resultados para «@q.Search»</p>
                }
                else
                {
                    <p>No hay resultados con los filtros actuales.</p>
                }
                <button type="button" class="btn btn-outline" data-filter-clear>Limpiar filtros</button>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th><a class="data-table__sort" href="@SortUrl("code")">Código@(Ind("code"))</a></th>
                            <th><a class="data-table__sort" href="@SortUrl("name")">Nombre@(Ind("name"))</a></th>
                            <th><a class="data-table__sort" href="@SortUrl("category")">Categoría@(Ind("category"))</a></th>
                            <th class="data-table__num"><a class="data-table__sort" href="@SortUrl("price")">Precio@(Ind("price"))</a></th>
                            <th class="data-table__num">Mínimo</th>
                            <th class="data-table__num"><a class="data-table__sort" href="@SortUrl("stock")">Existencia@(Ind("stock"))</a></th>
                            <th>Estado stock</th>
                            <th>Estatus</th>
                            @if (showActions)
                            {
                                <th class="data-table__actions"><span class="visually-hidden">Acciones</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in result.Items)
                    {
                        var deactivateFormId = $"product-deactivate-{item.Id}";
                        var activateFormId = $"product-activate-{item.Id}";
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.CategoryName</td>
                            <td class="data-table__num">@item.UnitPrice.ToString("N2")</td>
                            <td class="data-table__num">@item.MinStock</td>
                            <td class="data-table__num">@item.Stock</td>
                            <td>
                                <span class="badge @(item.StockStatus == "BAJO" ? "badge--warn" : "badge--ok")">
                                    @item.StockStatus
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.StatusId == 1 ? "badge--neutral" : "badge--muted")">
                                    @item.StatusName
                                </span>
                            </td>
                            @if (showActions)
                            {
                                <td class="data-table__actions">
                                    <div class="data-table__action-group">
                                        @if (canEdit)
                                        {
                                            <button type="button"
                                                    class="btn btn-ghost btn-sm"
                                                    data-modal-open="app-action-modal"
                                                    data-modal-title="Editar producto"
                                                    data-modal-url="@Url.Action("EditForm", "Products", new { id = item.Id })">
                                                Editar
                                            </button>
                                        }
                                        @if (canActivate && item.StatusId == 1)
                                        {
                                            <form id="@deactivateFormId"
                                                  class="visually-hidden"
                                                  method="post"
                                                  asp-controller="Products"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@item.Id"
                                                  data-confirm-ajax-form>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="RowVersion" value="@item.RowVersion" />
                                            </form>
                                            <button type="button"
                                                    class="btn btn-ghost btn-sm"
                                                    data-confirm-open
                                                    data-confirm-title="Desactivar producto"
                                                    data-confirm-message="¿Desactivar «@item.Name»? No podrá usarse en movimientos hasta reactivarlo."
                                                    data-confirm-accept="Desactivar"
                                                    data-confirm-tone="danger"
                                                    data-confirm-action="#@deactivateFormId">
                                                Desactivar
                                            </button>
                                        }
                                        @if (canActivate && item.StatusId == 2)
                                        {
                                            <form id="@activateFormId"
                                                  class="visually-hidden"
                                                  method="post"
                                                  asp-controller="Products"
                                                  asp-action="Activate"
                                                  asp-route-id="@item.Id"
                                                  data-confirm-ajax-form>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="RowVersion" value="@item.RowVersion" />
                                            </form>
                                            <button type="button"
                                                    class="btn btn-ghost btn-sm"
                                                    data-confirm-open
                                                    data-confirm-title="Activar producto"
                                                    data-confirm-message="¿Reactivar «@item.Name»?"
                                                    data-confirm-accept="Activar"
                                                    data-confirm-tone="neutral"
                                                    data-confirm-action="#@activateFormId">
                                                Activar
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <partial name="Ui/_Paginator" model="paginator" />
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const root = document.querySelector("[data-list-page]");
            if (root && window.InventarioUi?.filters) {
                window.InventarioUi.filters.bind(root);
            }
        });
    </script>
}
