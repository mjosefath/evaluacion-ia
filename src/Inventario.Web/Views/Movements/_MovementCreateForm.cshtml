@model Inventario.Web.Models.CreateMovementFormModel
@{
    var types = (IReadOnlyList<MovementTypeOption>)(ViewBag.PermittedTypes
                 ?? Array.Empty<MovementTypeOption>());
}
<form id="movement-form"
      asp-controller="Movements"
      asp-action="Create"
      method="post"
      class="movement-form"
      data-movement-form
      novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="movement-form__grid">
        <div class="form-field movement-form__type">
            <span class="form-label" id="movement-type-label">Tipo</span>
            <div class="type-pills" role="radiogroup" aria-labelledby="movement-type-label" data-type-pills>
                @foreach (var t in types)
                {
                    var selected = string.Equals(Model.Type, t.Code, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="type-pill@(selected ? " is-selected" : null)"
                            data-type-pill="@t.Code"
                            aria-pressed="@(selected ? "true" : "false")">
                        @t.Name
                    </button>
                }
            </div>
            <select id="movement-type"
                    name="Type"
                    class="visually-hidden"
                    data-movement-type
                    tabindex="-1"
                    aria-hidden="true">
                @foreach (var t in types)
                {
                    if (string.Equals(Model.Type, t.Code, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@t.Code" selected>@t.Name</option>
                    }
                    else
                    {
                        <option value="@t.Code">@t.Name</option>
                    }
                }
            </select>
            <span class="form-error" asp-validation-for="Type"></span>
        </div>

        <div class="form-field filter-field catalog-lookup movement-form__product"
             data-catalog-lookup
             data-catalog="products-lookup"
             data-catalog-url="/catalogs/products-lookup"
             data-active-only="true">
            <label class="form-label" for="movement-product">Producto</label>
            <select id="movement-product"
                    name="ProductId"
                    class="catalog-lookup__select"
                    data-catalog-select
                    data-movement-product
                    data-modal-initial-focus
                    placeholder="Buscar por código o nombre…"
                    autocomplete="off">
                @if (Model.ProductId > 0)
                {
                    <option value="@Model.ProductId" selected>@Model.ProductId</option>
                }
            </select>
            <p class="stock-chip" data-movement-stock hidden>
                <span class="stock-chip__label">Existencia</span>
                <strong class="stock-chip__value"></strong>
            </p>
            <span class="form-error" asp-validation-for="ProductId"></span>
        </div>

        <div class="form-field movement-form__qty">
            <label class="form-label" asp-for="Quantity">Cantidad</label>
            <input class="form-input"
                   asp-for="Quantity"
                   inputmode="numeric"
                   data-movement-quantity />
            <p class="form-hint" data-quantity-hint>Entero mayor que 0.</p>
            <span class="form-error" asp-validation-for="Quantity"></span>
        </div>

        <div class="form-field movement-form__reason">
            <label class="form-label" asp-for="Reason">Motivo</label>
            <input class="form-input"
                   asp-for="Reason"
                   maxlength="250"
                   data-movement-reason
                   placeholder="Opcional en entrada/salida" />
            <p class="form-hint" data-reason-hint>Opcional en entrada y salida; obligatorio en ajuste.</p>
            <span class="form-error" asp-validation-for="Reason"></span>
        </div>
    </div>

    <div class="movement-form__actions">
        <button type="submit" class="btn btn-primary" data-movement-submit>Guardar movimiento</button>
    </div>
</form>
