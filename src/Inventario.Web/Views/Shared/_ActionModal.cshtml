@*
  Modal de acción genérico (T03-01/T03-02).
  Abrir: InventarioUi.openModal(...) o data-modal-open + data-modal-title.
  Cerrar: closeModal / data-modal-close / Esc. Backdrop no cierra (evita perder el formulario).
  ChangePassword: form en el body; Guardar usa form="change-password-form" (submit AJAX).
*@
<dialog id="app-action-modal"
        class="action-modal ui-dialog"
        aria-labelledby="app-action-modal-title"
        aria-modal="true"
        tabindex="-1">
    <div class="action-modal-frame">
        <header class="action-modal-header">
            <h2 id="app-action-modal-title" class="action-modal-title" data-modal-title>Acción</h2>
        </header>
        <div class="action-modal-body" data-modal-body>
            <partial name="~/Views/Account/_ChangePasswordForm.cshtml" model="new ChangePasswordViewModel()" />
        </div>
        <footer class="action-modal-footer">
            <button type="button" class="btn btn-outline" data-modal-close>Cancelar</button>
            <button type="submit"
                    class="btn btn-primary"
                    form="change-password-form"
                    data-modal-primary>
                Guardar
            </button>
        </footer>
    </div>
</dialog>
