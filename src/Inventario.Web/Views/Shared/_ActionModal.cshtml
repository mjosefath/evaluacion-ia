@*
  Modal de acción genérico (T03-01). Shell vacío en layout; el cuerpo se rellena en tareas siguientes.
  Abrir: InventarioUi.openModal('app-action-modal' | element, { title?, onClose? })
         o atributo data-modal-open="app-action-modal" en el trigger.
  Cerrar: InventarioUi.closeModal(...), data-modal-close, o Esc (nativo).
  Backdrop: no cierra el modal de acción (evita perder datos del formulario); solo Esc / Cancelar.
*@
<dialog id="app-action-modal"
        class="action-modal ui-dialog"
        aria-labelledby="app-action-modal-title"
        aria-modal="true"
        tabindex="-1">
    <div class="action-modal-frame">
        <header class="action-modal-header">
            <h2 id="app-action-modal-title" class="action-modal-title" data-modal-title>Acción</h2>
        </header>
        <div class="action-modal-body" data-modal-body>
        </div>
        <footer class="action-modal-footer">
            <button type="button" class="btn btn-outline" data-modal-close>Cancelar</button>
            <button type="button" class="btn btn-primary" data-modal-primary hidden>Aceptar</button>
        </footer>
    </div>
</dialog>
