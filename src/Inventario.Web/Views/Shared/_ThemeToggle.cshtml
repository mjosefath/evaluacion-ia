@*
  Toggle light/dark (T05-03). Persistencia: localStorage inventario.theme.
*@
<button type="button"
        class="btn btn-ghost theme-toggle"
        data-theme-toggle
        aria-label="Activar modo oscuro"
        title="Modo oscuro">
    <svg class="icon theme-toggle-icon-moon" aria-hidden="true" focusable="false"><use href="#lucide-moon"/></svg>
    <svg class="icon theme-toggle-icon-sun" aria-hidden="true" focusable="false" hidden><use href="#lucide-sun"/></svg>
</button>
