<dialog id="app-confirm-dialog"
        class="confirm-dialog ui-dialog"
        aria-labelledby="confirm-title"
        aria-describedby="confirm-message">
    <h2 id="confirm-title" data-confirm-title>Confirmar</h2>
    <p id="confirm-message" data-confirm-message>¿Deseas continuar?</p>
    <div class="confirm-actions">
        <button type="button"
                class="btn btn-ghost"
                id="confirm-cancel"
                data-confirm-cancel>
            Cancelar
        </button>
        <button type="button"
                class="btn btn-danger"
                id="confirm-accept"
                data-confirm-accept>
            Confirmar
        </button>
    </div>
</dialog>
