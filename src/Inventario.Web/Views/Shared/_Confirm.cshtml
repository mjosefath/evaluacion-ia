<dialog id="app-confirm-dialog"
        class="confirm-dialog ui-dialog"
        aria-labelledby="confirm-title"
        aria-describedby="confirm-message">
    <h2 id="confirm-title">Confirmar</h2>
    <p id="confirm-message">¿Deseas continuar?</p>
    <div class="confirm-actions">
        <button type="button" class="btn btn-ghost" onclick="InventarioUi.closeConfirm()">Cancelar</button>
        <button type="button" class="btn btn-danger" id="confirm-accept" onclick="InventarioUi.closeConfirm()">Confirmar</button>
    </div>
</dialog>
