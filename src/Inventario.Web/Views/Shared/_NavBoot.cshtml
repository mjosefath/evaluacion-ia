@*
  Anti-flash desktop icon-rail: aplica html.nav-collapsed desde localStorage
  solo si viewport ≥801px (inventario.navCollapsed = "1").
*@
<script>
(function () {
  try {
    if (!window.matchMedia("(min-width: 801px)").matches) return;
    if (localStorage.getItem("inventario.navCollapsed") === "1") {
      document.documentElement.classList.add("nav-collapsed");
    }
  } catch (e) { /* ignore */ }
})();
</script>
