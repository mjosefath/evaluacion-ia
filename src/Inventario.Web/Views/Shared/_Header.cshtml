@{
    var displayName = User?.Identity?.IsAuthenticated == true
                      && !string.Equals(User.Identity.Name, "pending", StringComparison.Ordinal)
        ? User.Identity!.Name
        : (ViewData["DisplayName"] as string ?? "Usuario");
}

<header class="app-header">
    <div class="app-header-actions">
        <span class="app-header-user" id="header-display-name">@displayName</span>
        <details class="app-header-menu">
            <summary class="btn btn-outline" aria-haspopup="menu">Cuenta</summary>
            <div class="app-header-menu-panel" role="menu">
                <a role="menuitem"
                   href="#"
                   data-modal-open="app-action-modal"
                   data-modal-title="Cambiar contraseña">Cambiar contraseña</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" role="menuitem">Cerrar sesión</button>
                </form>
            </div>
        </details>
    </div>
</header>
