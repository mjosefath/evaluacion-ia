@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isInicio = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                   && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

<aside class="app-sidebar" aria-label="Navegación principal">
    <a class="app-brand" asp-controller="Home" asp-action="Index">Inventario</a>
    <nav class="app-nav" aria-label="Menú">
        <a class="app-nav-link @(isInicio ? "is-active" : null)"
           asp-controller="Home"
           asp-action="Index"
           aria-current="@(isInicio ? "page" : null)">
            <svg class="icon" aria-hidden="true" focusable="false"><use href="#lucide-house"/></svg>
            <span>Inicio</span>
        </a>
    </nav>
</aside>
