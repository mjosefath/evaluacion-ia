@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="app-page" aria-labelledby="page-title">
    <h1 id="page-title" class="app-page-title">Error</h1>
    <p class="text-muted">Ha ocurrido un problema al procesar la solicitud.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-caption">Request ID: @Model.RequestId</p>
    }
</section>
