@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var reference = Model?.RequestId;
}

<section class="app-page" aria-labelledby="page-title">
    <h1 id="page-title" class="app-page-title">Error</h1>
    <div class="alerts">
        <div class="alert alert-error" role="alert">
            @await Html.PartialAsync("_AlertIcon", "error")
            <div class="alert-content">
                <p>Ha ocurrido un problema al procesar la solicitud.</p>
                <p class="text-caption">Código de referencia: @(string.IsNullOrWhiteSpace(reference) ? "—" : reference)</p>
            </div>
        </div>
    </div>
</section>
