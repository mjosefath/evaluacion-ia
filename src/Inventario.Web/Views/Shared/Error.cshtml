@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="app-page" aria-labelledby="page-title">
    <h1 id="page-title" class="app-page-title">Error</h1>
    <div class="alerts">
        <div class="alert alert-error" role="alert">
            @await Html.PartialAsync("_AlertIcon", "error")
            <div class="alert-content">
                <p>Ha ocurrido un problema al procesar la solicitud.</p>
                @if (Model?.ShowRequestId == true)
                {
                    <p class="text-caption">Request ID: @Model.RequestId</p>
                }
            </div>
        </div>
    </div>
</section>
