@model string
@{
    var symbol = Model?.ToLowerInvariant() switch
    {
        "success" => "lucide-circle-check",
        "info" => "lucide-info",
        "error" => "lucide-circle-alert",
        _ => "lucide-info"
    };
}
<svg class="icon alert-icon" aria-hidden="true" focusable="false"><use href="#@symbol"/></svg>
